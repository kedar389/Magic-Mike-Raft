{
	// Multiplies the base enchantment capacity and all gains by this value. 1.0 is recommended.
	"capacity_multiplier": 1.0,
	// Default relic capacity of an item, recommended is 2 but 1 could provide for more interesting gameplay.
	"base_relic_capacity": 2,
	// XP is by default disabled in Ascendant Arcana, but can be optionally enabled and is fully supported if you do so.
	"disable_xp": false,
	// Hiding the XP bar can sometimes cause issues with other mods that modify the HUD, this mitigates those issues.
	"hide_xp_bar": false,
	// Levels are linear if enabled. This adjusts the XP required to level up each time. Setting this to 0 disables it.
	"xp_per_level": 30,
	// Some vanilla mobs drop relics on death, like Witches, Wither Skeletons, and bosses. Recommended.
	"add_relics_to_entities": true,
	// Relics are automatically added to ANY chest loot table containing an enchanted book. Recommended.
	"add_relics_to_chests": true,
	// Add restorine to any chests containing amethyst shards or diamonds
	"add_restorine_to_chests": true,
	// Add unique boss drops, like the Warden Heart. Disabling this will make some enchantments unobtainable.
	"add_boss_drops": true,
	// The minimum amount of power (bookshelves and enchanted books within range of an enchanting table) to enchant.
	"minimum_enchanting_power": 0,
	// The minimum amount of power required to enchant uncommon enchantments.
	"uncommon_enchanting_power": 22,
	// The minimum amount of power required to enchant rare enchantments.
	"rare_enchanting_power": 55,
	// The minimum amount of power required to enchant very rare enchantments.
	"very_rare_enchanting_power": 100,
	// Enchanted Books can only have one enchantment on them. Otherwise, they use the regular capacity system.
	"single_enchantment_books": true,
	// Enchanted Books placed in Chiseled Bookshelves near an Enchanting Table will remove the scrap cost for that enchantment.
	"books_remove_scrap_cost": false,
	/* The amount of tiers having an Enchanted Book in a Chiseled Bookshelf bypasses.
	   
	   For example, if this is set to 1 and you have a Miasma book in a nearby bookshelf you could now
	   enchant Miasma at Rare tier instead of Very Rare. If this is set to 4, books would completely
	   remove the power tier requirement at the enchanting table. Setting this to 0 disables this feature.
	*/
	"books_tier_bypass": 1,
	/* Ascendant Arcana disables many vanilla enchantments because they stress the capacity system too much with
	   'required' enchantments. Enchantments are generally meant to be more interesting and meaningfully impactful
	   but this list is configurable so you can enable or disable whatever you want.
	   
	   Do note that most enchantments on this list by default DO NOT come with recipes, so in order to see them in
	   the Enchanting Table you must create your own enchantment recipes for them with a datapack.
	*/
	"disabled_enchantments": [
		"minecraft:bane_of_arthropods",
		"majruszsenchantments:immortality",
		"minecraft:sharpness",
		"majruszsenchantments:gold_fuelled",
		"minecraft:efficiency",
		"minecraft:fire_protection",
		"minecraft:mending",
		"majruszsenchantments:enlightenment",
		"minecraft:power",
		"majruszsenchantments:misanthropy",
		"ascendant_arcana:coldheart",
		"majruszsenchantments:dodge",
		"ascendant_arcana:heart_of_the_storm",
		"minecraft:projectile_protection",
		"minecraft:smite",
		"minecraft:unbreaking",
		"minecraft:quick_charge",
		"minecraft:protection",
		"minecraft:blast_protection",
		"minecraft:impaling",
		"majruszsenchantments:smelter",
		"majruszsenchantments:magic_protection"
	],
	// Items which have their base relic capacity value overwritten.
	"base_relic_capacity_overrides": {
		"minecraft:crossbow": 1
	},
	/* Items which have their base enchantment capacity overwritten. The default enchantment capacity of an item
	   is determined by the vanilla enchantability stat of the item's material. For example, Diamond is 10 and
	   Netherite is 15. Items with an enchantability of 1 have their capacity increased to 10 by default.
	*/
	"base_enchantment_capacity_overrides": {
		"minecraft:shield": 15,
		"minecraft:crossbow": 20,
		"minecraft:enchanted_book": 12,
		"minecraft:bow": 20,
		"minecraft:trident": 15
	},
	// Enchantments which have their base rarity overwritten. Common is 1, Uncommon is 2, Rare is 3, Very Rare is 4. This might not work on modded enchantments.
	"overwritten_rarities": {
		"minecraft:knockback": 1,
		"minecraft:sweeping": 1,
		"minecraft:thorns": 2,
		"minecraft:feather_falling": 1,
		"minecraft:looting": 4,
		"minecraft:flame": 2,
		"minecraft:lure": 1,
		"minecraft:soul_speed": 3,
		"minecraft:aqua_affinity": 2,
		"minecraft:fire_aspect": 2,
		"minecraft:respiration": 1,
		"minecraft:swift_sneak": 3,
		"minecraft:frost_walker": 2,
		"minecraft:infinity": 3,
		"minecraft:fortune": 4,
		"minecraft:punch": 1,
		"minecraft:channeling": 2
	},
	/* Damage Relics apply to thrown Tridents, melee weapons, as well as arrows and rockets fired from bows and
	   crossbows.
	   Percentages are written as decimal values. For example, a 10% damage increase is written as 0.10 here.
	*/
	"damage_relic_strengths": {
		"1": 0.1,
		"2": 0.16,
		"3": 0.22,
		"4": 0.26,
		"5": 0.3
	},
	/* If this is true, infusing a durability relic applies the below bonus additively (i.e. the item's base
	   durability + the relic durability).
	   If this is false, infusing a durability relic applies the below bonus multiplicatively (i.e. the item's
	   base durability * the relic durability).
	*/
	"durability_additive": true,
	/* Durability Relics can apply to any item with a durability value. For all vanilla items, the default
	   values are better than Unbreaking 3.
	   If durability_additive is true, these values must be integers.
	   If durability_additive is false, these values are calculated as so: base * (1 + relic_strength)
	   For example, a relic strength of 0.5 is a multiplier of 1.5.
	*/
	"durability_relic_strengths": {
		"1": 600.0,
		"2": 1200.0,
		"3": 1800.0,
		"4": 2400.0,
		"5": 3000.0
	},
	/* Protection Relics reduce the damage taken from most sources. Generally, this is any instance of damage
	   that the original Protection enchantment would protect you from. The default values here are slightly
	   weaker than the original benefits of protection by 1% per level, meaning Protection 4 is 16% DR and
	   an Ascendant Protection Relic is 15%.
	   Percentages are written as decimal values. For example, a 3% damage resistance is written as 0.03 here.
	*/
	"protection_relic_strengths": {
		"1": 0.03,
		"2": 0.06,
		"3": 0.09,
		"4": 0.12,
		"5": 0.15
	},
	/* Haste Relics behave in a way that is technically not accurate. On weapons, Haste relics apply half of
	   their benefit (like other Haste effects in Minecraft). But for mining, Haste relics act as a level
	   of Efficiency. That level is obtained by multiplying the value of the haste relic by 10 and rounding down.
	   For example, a value of 0.10 (a 10% relic) becomes 1 level of Efficiency.
	   This behavior is likely to be changed in the future.
	   Percentages are written as decimal values. For example, a 10% haste increase is written as 0.10 here.
	*/
	"haste_relic_strengths": {
		"1": 0.1,
		"2": 0.2,
		"3": 0.3,
		"4": 0.4,
		"5": 0.5
	},
	/* Enchantment Capacity Relics are used to expand your item's capability to hold powerful enchantments.
	   These relics are additive.
	   Because Enchantment Capacity is an integer, you cannot add a decimal value here.
	*/
	"enchantment_capacity_relic_strengths": {
		"1": 5,
		"2": 10,
		"3": 15,
		"4": 20,
		"5": 25
	}
}