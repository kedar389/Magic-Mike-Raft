# Born in Chaos (mod id: born_in_chaos_v1) — game rules
# These are the mod's own custom game rules; edit values here.

# Spirit mobs burn/vanish in daylight
gamerule disappearanceofSpiritsUndertheSun true

# No maggots crawling from corpses on death
gamerule maggotsAppearance false

# No naturally-spawning corpse flies
# NOTE: does NOT stop the corpse-fly swarm from eating rotten flesh (not gamerule-gated)
gamerule corpseFlySpawn false

# Keep these mechanics ON
gamerule soulStratificationEffect true
gamerule theappearanceoftheNightmareStalker true
gamerule generationofInfectedDiamonds true
gamerule naughtinessMechanics true
